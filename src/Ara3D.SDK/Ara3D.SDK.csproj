<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Convenience meta-package: core, geometry, IO, Studio API, and Windows SDK libraries.</Description>
    <PackageProjectUrl>https://github.com/ara3d/ara3d-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ara3d/ara3d-sdk</RepositoryUrl>
    <Copyright>Copyright (c) Ara 3D Inc 2026, Licensed under MIT License</Copyright>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>true</IncludeSymbols>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageIcon>ara3d-128x128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LocalNuGetSourcePath>$(MSBuildProjectDirectory)\..\..\..\custom\piping-labs\local-nuget-source</LocalNuGetSourcePath>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <Target Name="CopyPackageToLocalNuGetSource" AfterTargets="Pack" Condition="Exists('$(LocalNuGetSourcePath)')">
    <ItemGroup>
      <LocalNuGetPackages Include="$(PackageOutputPath)\$(PackageId).$(PackageVersion)*.nupkg" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalNuGetPackages)" DestinationFolder="$(LocalNuGetSourcePath)" SkipUnchangedFiles="true" />
  </Target>
  
  <ItemGroup>
    <None Include="ara3d-128x128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ara3D.SDK.Core\Ara3D.SDK.Core.csproj" />
    <ProjectReference Include="..\Ara3D.SDK.Geometry\Ara3D.SDK.Geometry.csproj" />
    <ProjectReference Include="..\Ara3D.SDK.IO\Ara3D.SDK.IO.csproj" />
    <ProjectReference Include="..\Ara3D.Studio.API\Ara3D.Studio.API.csproj" />
    <ProjectReference Include="..\..\ext\Ara3D.Utils.Wpf\Ara3D.Utils.Wpf.csproj" />
  </ItemGroup>
</Project>
