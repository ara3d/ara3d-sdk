    <ProjectReference Include="..\Ara3D.Utils.Wpf\Ara3D.Utils.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="ara3d.ico" />
  </ItemGroup>
</Project>
