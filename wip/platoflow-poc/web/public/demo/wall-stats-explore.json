    { "id": "n2", "kind": "table.sql", "params": { "sql": "SELECT e.GlobalId, e.Name, MAX(CASE WHEN p.Name = 'Area' THEN TRY_CAST(p.Value AS DOUBLE) END) AS Area, MAX(CASE WHEN p.Name = 'Volume' THEN TRY_CAST(p.Value AS DOUBLE) END) AS Volume, MAX(CASE WHEN p.Name = 'Length' THEN TRY_CAST(p.Value AS DOUBLE) END) AS Length, MAX(CASE WHEN p.Name = 'Width' THEN TRY_CAST(p.Value AS DOUBLE) END) AS Width FROM EntityText e JOIN ParameterText p ON p.EntityIndex = e.EntityIndex WHERE e.Category = 'IFCWALL' GROUP BY e.GlobalId, e.Name" }, "x": 300, "y": 200 },
