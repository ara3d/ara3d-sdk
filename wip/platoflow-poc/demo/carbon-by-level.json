{
  "name": "carbon-by-level",
  "nodes": [
    { "id": "n1", "kind": "load.model", "params": { "model": "duplex" }, "x": 60, "y": 80 },
    { "id": "n2", "kind": "data.csv", "params": { "url": "/api/file?path=carbon.csv" }, "x": 60, "y": 260 },
    { "id": "n3", "kind": "attach.column", "params": { "keyColumn": "GlobalId", "valueColumn": "operational_carbon" }, "x": 320, "y": 140 },
    { "id": "n4", "kind": "viz.colormap", "params": { "ramp": "heat", "auto": false, "min": 0, "max": 420 }, "x": 320, "y": 320 },
    { "id": "n5", "kind": "viz.colorBy", "params": { "channel": "operational_carbon", "ghostOthers": false }, "x": 580, "y": 180 },
    { "id": "n6", "kind": "table.fromScene", "params": {}, "x": 580, "y": 360 },
    { "id": "n7", "kind": "table.aggregate", "params": { "groupBy": "Level", "value": "operational_carbon", "agg": "sum" }, "x": 800, "y": 360 },
    { "id": "n8", "kind": "sink.table", "params": {}, "x": 1010, "y": 360 }
  ],
  "edges": [
    { "from": { "node": "n1", "slot": "out" }, "to": { "node": "n3", "slot": "scene" } },
    { "from": { "node": "n2", "slot": "out" }, "to": { "node": "n3", "slot": "table" } },
    { "from": { "node": "n3", "slot": "out" }, "to": { "node": "n5", "slot": "scene" } },
    { "from": { "node": "n4", "slot": "out" }, "to": { "node": "n5", "slot": "colormap" } },
    { "from": { "node": "n3", "slot": "out" }, "to": { "node": "n6", "slot": "in" } },
    { "from": { "node": "n6", "slot": "out" }, "to": { "node": "n7", "slot": "in" } },
    { "from": { "node": "n7", "slot": "out" }, "to": { "node": "n8", "slot": "in" } }
  ],
  "display": "n5"
}
