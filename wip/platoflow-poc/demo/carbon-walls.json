    { "id": "n6", "kind": "viz.colorBy", "params": { "channel": "operational_carbon", "ghostOthers": true }, "x": 740, "y": 180 },
    { "id": "n7", "kind": "table.fromScene", "params": {}, "x": 740, "y": 360 },
    { "id": "n8", "kind": "sink.table", "params": {}, "x": 940, "y": 360 }
