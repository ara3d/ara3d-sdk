<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plato conformance test suite (docs/plato-roadmap.md Phase 1).

    This project does NOT reference Ara3D.Geometry. Instead it compiles its own
    Generated\ folder, produced by tools\regen-conformance.ps1 from the merge of
    submodules\Plato\plato-src (production, frozen) and
    submodules\Plato\plato-test-src (laws.plato + witness.plato).
    That keeps the Law_/Witness_ functions out of the production API and avoids
    duplicate-type collisions with the shipped Plato.Generated output.

    Run tools\regen-conformance.ps1 before building: Generated\ is not committed.

    Deliberately not added to any .sln (Phase 1 harness; wire into CI explicitly).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated code produces a large number of benign warnings; keep test output readable. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0660;CS0661;CS1591</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\src\Plato.Intrinsics\Plato.Intrinsics.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(Ara3DMicrosoftNetTestSdkVersion)" />
    <PackageReference Include="NUnit" Version="$(Ara3DNUnitVersion)" />
    <PackageReference Include="NUnit3TestAdapter" Version="$(Ara3DNUnit3TestAdapterVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ara3D.Collections\Ara3D.Collections.csproj" />
    <ProjectReference Include="..\..\src\Ara3D.Memory\Ara3D.Memory.csproj" />
    <ProjectReference Include="..\..\src\Ara3D.Utils\Ara3D.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <None Update="KnownFailures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
